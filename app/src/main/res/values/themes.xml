<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      自定义主题只为两件事：
      1. android:forceDarkAllowed=false —— 系统深色模式会把我们自绘的浅色界面强行反色，
         护眼绿会变成墨绿、白卡片变深灰，配色全乱。关掉它，颜色由 AppTheme 自己说了算。
      2. windowLightStatusBar 交给代码动态设置，这里不写死。
    -->
    <style name="Theme.QuickNotify" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- 深色弹窗：夜间模式下别再用白底晃眼 -->
    <style name="AppDialogDark" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/dialog_dark_bg</item>
        <item name="android:textColorPrimary">#F2F2F5</item>
        <item name="android:textColorSecondary">#A0A0A8</item>
        <item name="colorAccent">#9B8CFF</item>
        <item name="colorPrimary">#9B8CFF</item>
    </style>
</resources>
