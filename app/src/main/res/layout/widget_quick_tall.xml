<?xml version="1.0" encoding="utf-8"?>
<!--
  竖版插件：2 格宽 × 4 格高，2 列 × 4 行 = 8 个图标。
  适合放在桌面角落，图标比横版大一圈。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/wt_curve"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="4dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_curve_desc" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView android:id="@+id/wt0" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wt1" style="@style/WidgetIcon" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView android:id="@+id/wt2" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wt3" style="@style/WidgetIcon" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView android:id="@+id/wt4" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wt5" style="@style/WidgetIcon" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <ImageView android:id="@+id/wt6" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wt7" style="@style/WidgetIcon" />
    </LinearLayout>
</LinearLayout>
