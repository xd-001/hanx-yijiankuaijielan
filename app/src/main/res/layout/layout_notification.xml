    <!-- 第 0 行：高度由 32dp 提升至 40dp 黄金比例 -->
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:visibility="gone">
