<?xml version="1.0" encoding="utf-8"?>
<!--
  横版插件：4 格宽 × 2 格高，8 列 × 2 行 = 16 个图标。
  图标下面不写应用名（用户明确要求），靠图标本身辨认。
  顶部 40dp 留给打开次数曲线。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/wc_curve"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="4dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_curve_desc" />

    <LinearLayout
        android:id="@+id/wc_row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView android:id="@+id/wc0" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc1" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc2" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc3" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc4" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc5" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc6" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc7" style="@style/WidgetIcon" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wc_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageView android:id="@+id/wc8" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc9" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc10" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc11" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc12" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc13" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc14" style="@style/WidgetIcon" />
        <ImageView android:id="@+id/wc15" style="@style/WidgetIcon" />
    </LinearLayout>
</LinearLayout>
