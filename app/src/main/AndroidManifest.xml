<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 基础权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 💥 核心修复 1：新增专门对付安卓 14 (API 34) 严格审查的专属权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 【P0 新增】开机自启：没有这个，重启后通知永远回不来 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 【P1 新增】点击反馈：轻量震动，不涉隐私 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="快捷通知"
        android:icon="@drawable/app_icon"
        android:theme="@style/Theme.QuickNotify">

        <!-- 入口改为 activity-alias（见下），Activity 本身不再挂 LAUNCHER 过滤，
             否则桌面会出现「原图标 + 新图标」两个入口 -->
        <activity android:name=".MainActivity" android:label="快捷通知" android:exported="true" android:excludeFromRecents="true" />

        <!-- 图标入口：同一时间只启用一个，切图标 = 启用目标 + 禁用其余 -->
        <activity-alias
            android:name=".IconDefault"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/app_icon"
            android:label="快捷通知">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconPurple"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_style_purple"
            android:label="快捷通知">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconBars"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_style_bars"
            android:label="快捷通知">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconDots"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_style_dots"
            android:label="快捷通知">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 【P1 新增】透明代理 Activity：点击图标时先反馈+记录，再启动目标 App -->
        <activity
            android:name=".LaunchProxyActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true" />

        <!-- 💥 核心修复 2：加上 foregroundServiceType="dataSync" 骗过系统审查，防止后台被直接绞杀 -->
        <service android:name=".QuickService"
                 android:label=" "
                 android:exported="false"
                 android:foregroundServiceType="dataSync" />

        <!-- 桌面插件：横版 4x2 / 竖版 2x4，内容与通知栏同源 -->
        <receiver android:name=".QuickWidgetWideProvider" android:exported="true" android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_wide_info" />
        </receiver>

        <receiver android:name=".QuickWidgetTallProvider" android:exported="true" android:label="@string/widget_tall_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_tall_info" />
        </receiver>

        <!-- 【P0 新增】开机 / 升级 / 解锁 自启 -->
        <receiver android:name=".BootReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_INITIALIZE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 【P0 新增】看门狗：定时检查通知是否还在，被杀后自愈拉起 -->
        <receiver android:name=".WatchdogReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="com.my.app.WATCHDOG_TICK" />
                <action android:name="com.my.app.REFRESH_NOTIFICATION" />
            </intent-filter>
        </receiver>

        <!-- 【新增】翻页键：点通知右下角页码切下一页 -->
        <receiver android:name=".PageReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="com.my.app.PAGE_NEXT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
